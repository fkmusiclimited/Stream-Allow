# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Hostinger Ubuntu 24.04 VPS or Cloud PostgreSQL)
# Format: postgresql://username:password@localhost:5432/streamjoin
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/streamjoin"

# ENCRYPTION_SECRET: 32-byte secret key used for AES-256-GCM encryption of sensitive RTMP Stream Keys
ENCRYPTION_SECRET="YOUR_32_BYTE_MASTER_ENCRYPTION_SECRET_KEY"

# JWT_SECRET: Secret for signing user authentication session tokens
JWT_SECRET="YOUR_PRODUCTION_JWT_SECRET_KEY"
